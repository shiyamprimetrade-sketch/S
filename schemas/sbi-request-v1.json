{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SBI request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "capability",
    "deadline_ms",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "capability": {
      "enum": [
        "calculator",
        "website",
        "inventory"
      ]
    },
    "deadline_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120000
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement"
      ],
      "properties": {
        "requirement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        }
      }
    }
  }
}